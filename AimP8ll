-- Version corrigée du menu AimPillOGs
-- Mettre ce LocalScript dans StarterGui

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Création du ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AimPillMenu"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = playerGui

-- Frame principal
local Frame = Instance.new("Frame")
Frame.Name = "Frame"
Frame.Size = UDim2.new(0, 300, 0, 400)
Frame.Position = UDim2.new(0.5, -150, 0.5, -200)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Parent = ScreenGui

-- Exemple pour les boutons Main, Misc, Visuals, Settings
local function CreateButton(name, position)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = name
	btn.Size = UDim2.new(0, 120, 0, 40)
	btn.Position = position
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Parent = Frame
	return btn
end

local Main = CreateButton("Main", UDim2.new(0, 10, 0, 10))
local Misc = CreateButton("Misc", UDim2.new(0, 10, 0, 60))
local Visuals = CreateButton("Visuals", UDim2.new(0, 10, 0, 110))
local Settings = CreateButton("Settings", UDim2.new(0, 10, 0, 160))

-- Exemple de sub-menu (visible uniquement quand le bouton est cliqué)
local function CreateSubMenu(name, position)
	local sub = Instance.new("Frame")
	sub.Name = name.."Menu"
	sub.Size = UDim2.new(0, 200, 0, 150)
	sub.Position = position
	sub.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	sub.Visible = false
	sub.Parent = Frame
	return sub
end

local MainMenu = CreateSubMenu("Main", UDim2.new(0, 150, 0, 10))
local MiscMenu = CreateSubMenu("Misc", UDim2.new(0, 150, 0, 60))
local VisualsMenu = CreateSubMenu("Visuals", UDim2.new(0, 150, 0, 110))
local SettingsMenu = CreateSubMenu("Settings", UDim2.new(0, 150, 0, 160))

-- Fonction pour toggle un sub-menu
local function toggleMenu(menu)
	for _, child in pairs(Frame:GetChildren()) do
		if child:IsA("Frame") and child.Name:find("Menu") then
			child.Visible = false
		end
	end
	menu.Visible = true
end

Main.MouseButton1Click:Connect(function() toggleMenu(MainMenu) end)
Misc.MouseButton1Click:Connect(function() toggleMenu(MiscMenu) end)
Visuals.MouseButton1Click:Connect(function() toggleMenu(VisualsMenu) end)
Settings.MouseButton1Click:Connect(function() toggleMenu(SettingsMenu) end)

-- Fonction pour rendre le menu draggable
local UIS = game:GetService("UserInputService")
local dragging = false
local dragInput, mousePos, framePos

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = input.Position
		framePos = Frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

Frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - mousePos
		Frame.Position = UDim2.new(
			framePos.X.Scale, framePos.X.Offset + delta.X,
			framePos.Y.Scale, framePos.Y.Offset + delta.Y
		)
	end
end)

-- Toggle menu avec RightShift
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		ScreenGui.Enabled = not ScreenGui.Enabled
		-- fermer tous les sub-menus quand on ferme le menu principal
		if not ScreenGui.Enabled then
			for _, child in pairs(Frame:GetChildren()) do
				if child:IsA("Frame") and child.Name:find("Menu") then
					child.Visible = false
				end
			end
		end
	end
end)
