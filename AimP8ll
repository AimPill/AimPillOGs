gui.Name = "ExecutorMenu"
gui.ResetOnSpawn = false
gui.Parent = playerGui

--// MAIN FRAME
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,400,0,250)
frame.Position = UDim2.new(0.5,-200,0.5,-125)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
frame.BorderSizePixel = 0
frame.Parent = gui

--// TITLE
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.BackgroundTransparency = 1
title.Text = "AimPill Menu"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Parent = frame

--// TAB BUTTON HOLDER
local tabs = Instance.new("Frame")
tabs.Size = UDim2.new(0,100,1,-30)
tabs.Position = UDim2.new(0,0,0,30)
tabs.BackgroundColor3 = Color3.fromRGB(25,25,25)
tabs.Parent = frame

--// CONTENT HOLDER
local content = Instance.new("Frame")
content.Size = UDim2.new(1,-100,1,-30)
content.Position = UDim2.new(0,100,0,30)
content.BackgroundTransparency = 1
content.Parent = frame

--// PAGES
local pages = {}

local function createPage(name)
local page = Instance.new("Frame")
page.Size = UDim2.new(1,0,1,0)
page.Visible = false
page.BackgroundTransparency = 1
page.Parent = content
pages[name] = page
return page
end

local mainPage = createPage("Main")
local visualsPage = createPage("Visuals")
local miscPage = createPage("Misc")
local settingsPage = createPage("Settings")

mainPage.Visible = true

--// BUTTON CREATOR
local function createButton(name,order)

```
local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1,0,0,40)
btn.Position = UDim2.new(0,0,0,(order-1)*40)
btn.Text = name
btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
btn.TextColor3 = Color3.new(1,1,1)
btn.Parent = tabs

btn.MouseButton1Click:Connect(function()

	for _,v in pairs(pages) do
		v.Visible = false
	end

	pages[name].Visible = true

end)
```

end

createButton("Main",1)
createButton("Visuals",2)
createButton("Misc",3)
createButton("Settings",4)

